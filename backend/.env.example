PROJECT_NAME="Sistema de Control de Asistencia K20"
API_V1_STR="/api/v1"
SECRET_KEY="cambiar-esta-clave-secreta-en-produccion"
ENVIRONMENT="development"

# MySQL Laragon Configuration
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=asistencia_k20

# Biometric Device ZKTeco K20 Configuration
ZK_DEVICE_IP=192.168.10.69
ZK_DEVICE_PORT=4370
ZK_DEVICE_PLATFORM=ZLM60_TFT
ZK_DEVICE_NAME=ZKTeco K20

# Data paths
CSV_DATA_PATH=../datos/registros_k20.csv
EXPORTS_DIR=./exports

# Security / Access
API_ACCESS_TOKEN=k20-local-dev-token-2026
# Credenciales de administrador. En producción use ADMIN_PASSWORD_HASH (pbkdf2_sha256)
# y deje ADMIN_PASSWORD vacío.
ADMIN_USER=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
TOKEN_EXPIRACION_MINUTOS=480
LOGIN_MAX_INTENTOS=5
LOGIN_BLOQUEO_MINUTOS=5
ALLOWED_HOSTS=["127.0.0.1", "localhost"]
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# Sincronización biométrica (Fase 2) - desactivada por defecto
SYNC_AUTOMATICA_ENABLED=False
SYNC_INTERVALO_MINUTOS=10
ZK_TIMEOUT_SEGUNDOS=10
ZK_REINTENTOS=2
SYNC_EJECUCION_COLGADA_MINUTOS=30

