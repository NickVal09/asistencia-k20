# Normalizacion de finales de linea.
# Los scripts de shell dentro del contenedor Linux DEBEN usar LF: si llevan
# CRLF, /bin/sh falla al arrancar el contenedor.
*.sh            text eol=lf
entrypoint.sh   text eol=lf
Dockerfile      text eol=lf
*.py            text
*.js            text
*.vue           text
*.json          text
*.md            text
*.yml           text
*.yaml          text
